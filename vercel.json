{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,__pycache__/**,.pytest_cache/**,node_modules/**,dist/**,.git/**,.cursor/**,certs/**,Dockerfile,docker-compose.yml,start-docker.sh,run_crop_app.py,crop_server.py,poster_tiler.py,preview.html,start.bat,启动.bat,entrypoint.py}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/crop.html"
    },
    {
      "source": "/api/export_prepare",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/tile_export_prepare",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.py"
    }
  ]
}
